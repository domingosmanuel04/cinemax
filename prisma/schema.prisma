generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  phone            String?
  dateOfBirth      DateTime?
  avatarUrl        String?
  locale           String    @default("pt")
  preferredCinemaId String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  role             String    @default("CUSTOMER")
  status           String    @default("ACTIVE")
  emailVerified    DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  preferredCinema  Cinema?   @relation("PreferredCinema", fields: [preferredCinemaId], references: [id])
  staffProfile     StaffProfile?
  profiles         Profile[]
  tickets          Ticket[]
  orders           Order[]
  payments         Payment[]
  subscriptions    Subscription[]
  watchHistory     WatchHistory[]
  watchlist        WatchlistItem[]
  reviews          Review[]
  ratings          Rating[]
  notifications    Notification[]
  loyalty          LoyaltyAccount?
  favorites        Favorite[]
  aiConversations  AiConversation[]
  auditLogs        AuditLog[]
  seatHolds        SeatHold[]
  reviewsHelpful   ReviewVote[]
  campaigns        Campaign[]        @relation("CampaignCreator")

  @@index([role, status])
  @@index([email])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String
  name            String
  avatarUrl       String?
  isKids          Boolean  @default(false)
  maturityRating  String   @default("18")
  language        String   @default("pt")
  pin             String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory    WatchHistory[]
  watchlist       WatchlistItem[]

  @@index([userId])
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  cinemaId  String?
  jobTitle  String
  shift     String   @default("FLEX")
  status    String   @default("ACTIVE")
  hiredAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cinema    Cinema?  @relation(fields: [cinemaId], references: [id])
}

model Cinema {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  address       String
  city          String
  country       String   @default("Angola")
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?
  openingHours  String
  parking       Boolean  @default(true)
  accessible    Boolean  @default(true)
  services      String   @default("[]")
  imageUrl      String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms         Room[]
  sessions      Session[]
  staff         StaffProfile[]
  preferredBy   User[]          @relation("PreferredCinema")
  inventory     InventoryItem[]
  licenses      ContentLicense[]

  @@index([city, status])
}

model Room {
  id           String   @id @default(cuid())
  cinemaId     String
  name         String
  number       Int
  capacity     Int
  type         String   @default("STANDARD")
  formats      String   @default("[\"2D\"]")
  screenType   String   @default("Laser")
  soundSystem  String   @default("Dolby Atmos")
  imageUrl     String?
  rows         Int      @default(10)
  columns      Int      @default(14)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cinema       Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats        Seat[]
  sessions     Session[]

  @@unique([cinemaId, number])
  @@index([cinemaId, status])
}

model Seat {
  id        String   @id @default(cuid())
  roomId    String
  row       String
  number    Int
  type      String   @default("STANDARD")
  status    String   @default("ACTIVE")
  posX      Int
  posY      Int
  isAisle   Boolean  @default(false)

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tickets   TicketItem[]
  holds     SeatHold[]

  @@unique([roomId, row, number])
  @@index([roomId, type])
}

model Genre {
  id     String        @id @default(cuid())
  name   String        @unique
  slug   String        @unique
  movies MovieGenre[]
  series SeriesGenre[]
}

model Person {
  id        String      @id @default(cuid())
  name      String
  role      String      @default("ACTOR")
  photoUrl  String?
  bio       String?
  movieCast MovieCast[]
}

model Movie {
  id                 String    @id @default(cuid())
  title              String
  originalTitle      String?
  slug               String    @unique
  synopsis           String
  posterUrl          String
  backdropUrl        String
  trailerUrl         String?
  videoUrl           String?
  year               Int
  durationMin        Int
  rating             String    @default("M/12")
  language           String    @default("pt")
  subtitles          String    @default("[\"pt\"]")
  formats            String    @default("[\"2D\"]")
  status             String    @default("NOW_SHOWING")
  releaseDate        DateTime?
  endDate            DateTime?
  cinemaAvailable    Boolean   @default(true)
  streamingAvailable Boolean   @default(false)
  featured           Boolean   @default(false)
  heroEnabled        Boolean   @default(false)
  heroOrder          Int       @default(0)
  heroCta            String?
  avgRating          Float     @default(0)
  voteCount          Int       @default(0)
  popularity         Int       @default(0)
  director           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  genres             MovieGenre[]
  cast               MovieCast[]
  trailers           Trailer[]
  media              MediaAsset[]
  sessions           Session[]
  reviews            Review[]
  ratings            Rating[]
  watchHistory       WatchHistory[]
  watchlist          WatchlistItem[]
  favorites          Favorite[]
  licenses           ContentLicense[]
  similarFrom        SimilarMovie[]  @relation("MovieSimilar")
  similarTo          SimilarMovie[]  @relation("SimilarOf")

  @@index([status, featured])
  @@index([slug])
  @@index([heroEnabled, heroOrder])
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model MovieCast {
  id       String @id @default(cuid())
  movieId  String
  personId String
  character String?
  order    Int    @default(0)
  movie    Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model SimilarMovie {
  movieId   String
  similarId String
  movie     Movie  @relation("MovieSimilar", fields: [movieId], references: [id], onDelete: Cascade)
  similar   Movie  @relation("SimilarOf", fields: [similarId], references: [id], onDelete: Cascade)

  @@id([movieId, similarId])
}

model Series {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  synopsis           String
  posterUrl          String
  backdropUrl        String
  trailerUrl         String?
  year               Int
  rating             String    @default("M/12")
  status             String    @default("PUBLISHED")
  streamingAvailable Boolean   @default(true)
  featured           Boolean   @default(false)
  avgRating          Float     @default(0)
  popularity         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  genres             SeriesGenre[]
  seasons            Season[]
  licenses           ContentLicense[]
  watchHistory       WatchHistory[]
  watchlist          WatchlistItem[]
}

model SeriesGenre {
  seriesId String
  genreId  String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
}

model Season {
  id         String    @id @default(cuid())
  seriesId   String
  number     Int
  title      String
  synopsis   String?
  year       Int
  posterUrl  String?
  series     Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes   Episode[]

  @@unique([seriesId, number])
}

model Episode {
  id          String   @id @default(cuid())
  seasonId    String
  number      Int
  title       String
  synopsis    String?
  durationMin Int
  videoUrl    String?
  thumbnailUrl String?
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@unique([seasonId, number])
}

model Trailer {
  id        String   @id @default(cuid())
  movieId   String
  title     String
  url       String
  type      String   @default("OFFICIAL")
  duration  Int?
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id        String   @id @default(cuid())
  movieId   String?
  type      String
  url       String
  alt       String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  ctaLabel    String?
  ctaHref     String?
  placement   String    @default("HOME")
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  body        String
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id          String    @id @default(cuid())
  movieId     String
  cinemaId    String
  roomId      String
  startsAt    DateTime
  endsAt      DateTime
  format      String    @default("2D")
  language    String    @default("pt")
  subtitles   String?
  price       Int
  status      String    @default("SCHEDULED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  movie       Movie     @relation(fields: [movieId], references: [id])
  cinema      Cinema    @relation(fields: [cinemaId], references: [id])
  room        Room      @relation(fields: [roomId], references: [id])
  tickets     Ticket[]
  holds       SeatHold[]

  @@index([startsAt, status])
  @@index([cinemaId, startsAt])
  @@index([movieId, startsAt])
  @@index([roomId, startsAt])
}

model SeatHold {
  id         String   @id @default(cuid())
  sessionId  String
  seatId     String
  userId     String?
  token      String
  expiresAt  DateTime
  status     String   @default("HOLD")
  createdAt  DateTime @default(now())

  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([sessionId, seatId, status])
  @@index([expiresAt, status])
}

model Ticket {
  id          String       @id @default(cuid())
  code        String       @unique
  userId      String
  sessionId   String
  orderId     String?
  status      String       @default("PENDING")
  qrPayload   String
  checkedInAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  session     Session      @relation(fields: [sessionId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])
  items       TicketItem[]

  @@index([userId, status])
  @@index([sessionId])
}

model TicketItem {
  id        String  @id @default(cuid())
  ticketId  String
  seatId    String
  price     Int
  ticket    Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  seat      Seat    @relation(fields: [seatId], references: [id])

  @@unique([ticketId, seatId])
}

model ProductCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String          @id @default(cuid())
  categoryId  String
  name        String
  slug        String          @unique
  description String
  price       Int
  imageUrl    String
  pointsAward Int             @default(10)
  status      String          @default("ACTIVE")
  featured    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category    ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  inventory   InventoryItem[]
}

model InventoryItem {
  id          String   @id @default(cuid())
  productId   String
  cinemaId    String
  stock       Int      @default(0)
  minStock    Int      @default(20)
  product     Product  @relation(fields: [productId], references: [id])
  cinema      Cinema   @relation(fields: [cinemaId], references: [id])
  movements   StockMovement[]

  @@unique([productId, cinemaId])
}

model StockMovement {
  id              String         @id @default(cuid())
  inventoryItemId String
  type            String
  quantity        Int
  note            String?
  createdAt       DateTime       @default(now())
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  userId        String
  type          String      @default("TICKET")
  status        String      @default("PENDING")
  subtotal      Int
  discount      Int         @default(0)
  fees          Int         @default(0)
  total         Int
  currency      String      @default("AOA")
  couponId      String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  tickets       Ticket[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  unitPrice Int
  total     Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  orderId       String?
  subscriptionId String?
  provider      String
  method        String
  amount        Int
  currency      String   @default("AOA")
  status        String   @default("PENDING")
  reference     String   @unique
  externalId    String?
  metadata      String   @default("{}")
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  order         Order?   @relation(fields: [orderId], references: [id])
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  tagline       String
  monthlyPrice  Int
  yearlyPrice   Int
  currency      String         @default("AOA")
  maxDevices    Int
  quality       String
  features      String
  trialDays     Int            @default(7)
  active        Boolean        @default(true)
  highlight     Boolean        @default(false)
  sortOrder     Int            @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id            String           @id @default(cuid())
  userId        String
  planId        String
  status        String           @default("TRIALING")
  interval      String           @default("MONTHLY")
  currentPeriodStart DateTime    @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean     @default(false)
  cancelledAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id])
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  payments      Payment[]
}

model WatchHistory {
  id          String    @id @default(cuid())
  userId      String
  profileId   String?
  movieId     String?
  seriesId    String?
  episodeId   String?
  progressSec Int       @default(0)
  durationSec Int       @default(0)
  completed   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile     Profile?  @relation(fields: [profileId], references: [id])
  movie       Movie?    @relation(fields: [movieId], references: [id])
  series      Series?   @relation(fields: [seriesId], references: [id])
  episode     Episode?  @relation(fields: [episodeId], references: [id])

  @@index([userId, updatedAt])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  profileId String?
  movieId   String?
  seriesId  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile? @relation(fields: [profileId], references: [id])
  movie     Movie?   @relation(fields: [movieId], references: [id])
  series    Series?  @relation(fields: [seriesId], references: [id])

  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Review {
  id          String       @id @default(cuid())
  userId      String
  movieId     String
  rating      Int
  body        String
  status      String       @default("PUBLISHED")
  spamScore   Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  movie       Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  votes       ReviewVote[]
}

model ReviewVote {
  id       String @id @default(cuid())
  reviewId String
  userId   String
  value    Int
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model Rating {
  id      String @id @default(cuid())
  userId  String
  movieId String
  value   Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String
  type          String
  value         Int
  minAmount     Int       @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean   @default(true)
  orders        Order[]
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  type        String
  imageUrl    String
  discount    Int?
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean   @default(true)
  featured    Boolean   @default(false)
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  objective   String
  audience    String
  channels    String
  copy        String
  cta         String
  discount    String?
  status      String   @default("DRAFT")
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("CampaignCreator", fields: [createdById], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  href      String?
  readAt    DateTime?
  channel   String    @default("IN_APP")
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model LoyaltyAccount {
  id          String                @id @default(cuid())
  userId      String                @unique
  points      Int                   @default(0)
  lifetime    Int                   @default(0)
  tier        String                @default("BRONZE")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  points    Int
  reason    String
  ref       String?
  createdAt DateTime       @default(now())
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model ContentLicense {
  id         String    @id @default(cuid())
  movieId    String?
  seriesId   String?
  cinemaId   String?
  territory  String    @default("AO")
  type       String
  cinemaOk   Boolean   @default(true)
  streamingOk Boolean  @default(false)
  downloadOk Boolean   @default(false)
  startsAt   DateTime
  endsAt     DateTime
  status     String    @default("ACTIVE")
  notes      String?
  movie      Movie?    @relation(fields: [movieId], references: [id])
  series     Series?   @relation(fields: [seriesId], references: [id])
  cinema     Cinema?   @relation(fields: [cinemaId], references: [id])

  @@index([endsAt, status])
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String?
  scope     String      @default("PUBLIC")
  title     String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Alert {
  id        String   @id @default(cuid())
  type      String
  severity  String
  title     String
  body      String
  href      String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  userId    String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}
